{
  "type": "module",
  "scripts": {
    "dev": "node resources/vite/vite.js && vite",
    "watch": "npm run dev",
    "build": "node resources/vite/vite.js --build && npm run admin && npm run fluent-player && npm run fluent-playlist && npm run fluent-player-modal && npm run gutenberg && npm run elementor && npm run elementor-canvas && npm run elementor-playlist-canvas && npm run divi-vb && npm run divi-playlist && npm run vidstack-loader && npm run gutenberg-playlist && npm run timed-content && npm run media-toolbar && npm run merge-manifests",
    "admin": "vite build --mode=admin",
    "fluent-player": "vite build --mode=fluent-player",
    "fluent-playlist": "vite build --mode=fluent-playlist",
    "fluent-player-modal": "vite build --mode=fluent-player-modal",
    "gutenberg": "vite build --mode=gutenberg",
    "elementor": "vite build --mode=elementor",
    "elementor-canvas": "vite build --mode=elementor-canvas",
    "elementor-playlist-canvas": "vite build --mode=elementor-playlist-canvas",
    "vidstack-loader": "vite build --mode=vidstack-loader",
    "gutenberg-playlist": "vite build --mode=gutenberg-playlist",
    "timed-content": "vite build --mode=timed-content",
    "media-toolbar": "vite build --mode=media-toolbar",
    "frontend": "npm run fluent-player && npm run fluent-playlist && npm run fluent-player-modal && npm run vidstack-loader && npm run merge-manifests",
    "merge-manifests": "node merge-manifests.js",
    "production": "node resources/vite/vite.js --build --production && npm run fluent-player && npm run fluent-playlist && npm run fluent-player-modal && npm run admin && npm run gutenberg && npm run elementor && npm run elementor-canvas && npm run elementor-playlist-canvas && npm run divi-vb && npm run divi-playlist && npm run vidstack-loader && npm run gutenberg-playlist && npm run timed-content && npm run media-toolbar && npm run merge-manifests",
    "prod": "npm run production",
    "translations": "node resources/dev/translator.js",
    "postinstall": "echo 'Dependencies installed successfully'",
    "test:phpunit": "cd dev && ./vendor/bin/phpunit -c ../tests/php/phpunit.xml.dist",
    "test:phpunit:coverage": "bash scripts/phpunit-coverage.sh",
    "test:build": "cd tests/wp-browser && vendor/bin/codecept build",
    "test:integration": "cd tests/wp-browser && vendor/bin/codecept run Integration",
    "test:functional": "cd tests/wp-browser && vendor/bin/codecept run Functional",
    "test:codecept": "npm run test:functional && npm run test:integration",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:report": "node tests/report/build-report.mjs",
    "test:all": "npm run test:unit:coverage && npm run test:report",
    "test:e2e": "NODE_TLS_REJECT_UNAUTHORIZED=0 playwright test",
    "test:e2e:live": "E2E_VISUAL_DELAY_MS=${E2E_VISUAL_DELAY_MS:-3000} NODE_TLS_REJECT_UNAUTHORIZED=0 playwright test --project=chromium --headed --workers=1",
    "test:e2e:ui": "NODE_TLS_REJECT_UNAUTHORIZED=0 playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:isolated": "node tests/e2e/run-isolated.js",
    "test:e2e:isolated:live": "E2E_VISUAL_DELAY_MS=${E2E_VISUAL_DELAY_MS:-3000} node tests/e2e/run-isolated.js --headed --workers=1",
    "test:e2e:isolated:ui": "node tests/e2e/run-isolated.js --ui",
    "test:e2e:isolated:debug": "node tests/e2e/run-isolated.js --debug",
    "test:e2e:isolated:teardown": "bash tests/e2e/teardown-isolated.sh",
    "divi-vb": "vite build --mode=divi-vb",
    "divi-playlist": "vite build --mode=divi-playlist"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.0.9",
    "@mux/upchunk": "^3.5.0",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitejs/plugin-vue": "^4.3.4",
    "clipboard": "^2.0.11",
    "echarts": "^5.6.0",
    "element-plus": "^2.2.17",
    "hls.js": "^1.5.7",
    "lodash": "^4.17.21",
    "media-icons": "^1.1.4",
    "mux-embed": "^5.4.0",
    "react-refresh": "^0.17.0",
    "vidstack": "^1.12.13",
    "vue": "^3.2.40",
    "vue-router": "^4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.59.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitest/coverage-v8": "^4.1.4",
    "@vue/compiler-sfc": "^3.2.40",
    "@vue/test-utils": "^2.4.11",
    "axe-core": "^4.11.4",
    "eslint": "^10.5.0",
    "eslint-plugin-vue": "^10.9.2",
    "glob": "^10.3.4",
    "jsdom": "^29.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "resolve-url-loader": "^5.0.0",
    "sass": "^1.55.0",
    "sass-loader": "^13.0.2",
    "unplugin-auto-import": "^0.11.2",
    "unplugin-vue-components": "^0.22.7",
    "vite": "^4.4.9",
    "vite-plugin-live-reload": "^3.0.2",
    "vite-plugin-static-copy": "^0.16.0",
    "vitest": "^4.1.6",
    "vue-loader": "^17.0.0"
  }
}
